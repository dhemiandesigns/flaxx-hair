  "principles": [
    {"id":"FH-P1","name":"Truth through the chain","rule":"No material claim without traceable product- or batch-linked support."},
    {"id":"FH-P2","name":"Release by documented standard","rule":"No sale or shipment before the acceptance standard passes and the evidence record is complete."},
    {"id":"FH-P3","name":"Informed choice","rule":"Material limitations, variation, origin, composition, care, and expected behaviour remain visible and accurate."},
    {"id":"FH-P4","name":"Responsibility for mismatch","rule":"Contain, investigate, communicate, and perform the approved remedy."},
    {"id":"FH-P5","name":"Controlled deepening","rule":"Deeper production control requires its own traceability, quality, legal, economic, and capacity gates."},
    {"id":"FH-P6","name":"Growth within the promise","rule":"No expansion beyond proven release, cash, people, support, and external capacity."},
    {"id":"FH-P7","name":"Human dignity","rule":"No source path may depend on coercion, exploitation, deception, forced labour, child labour, or unestablished legitimacy."},
    {"id":"FH-P8","name":"30 / 60 / 100 multiplication","rule":"The 30 level is the minimum return standard; below it triggers review and blocks growth commitments."},
    {"id":"FH-P9","name":"Addition releases multiplication","rule":"A non-founding hire or consultant requires a documented credible path to 10x multiplication."},
    {"id":"FH-P10","name":"Creator stewardship remains controlling","rule":"Creator ownership may not fall below 51 percent."},
    {"id":"FH-P11","name":"Founding return endures","rule":"Founder return remains separate from current labour and is distributed only from confirmed surplus after obligations."},
    {"id":"FH-P12","name":"Quality mark inseparable from the standard","rule":"No mark use may be separated from FH-P1 through FH-P4 evidence and accountability."}
  ],
